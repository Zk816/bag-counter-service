# Copy to deploy/.env and adjust.
BAGCOUNTER_HTTP_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=change-me

# CPU budget of the inference worker: threads per inference and (optionally) the cores it may use.
BAGCOUNTER_INFER_THREADS=8
BAGCOUNTER_CPUSET=
BAGCOUNTER_WORKER_MEM=4g

BAGCOUNTER_MAX_CAMERAS=4
BAGCOUNTER_LOG_LEVEL=INFO
